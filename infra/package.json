{
  "name": "wiedoethet-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK (TypeScript) app that adopts wieDoetHet's existing, hand-deployed AWS resources (DynamoDB, Lambda, API Gateway) into CloudFormation via `cdk import`. See DESIGN.md and IMPORT_CHECKLIST.md before running anything against live AWS.",
  "bin": {
    "wiedoethet-infra": "bin/wiedoethet.js"
  },
  "scripts": {
    "predeploy": "cd ../lambda && npm run build",
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "npm run predeploy && cdk synth",
    "diff": "npm run predeploy && cdk diff",
    "deploy": "npm run predeploy && cdk deploy",
    "import": "npm run predeploy && cdk import",
    "destroy": "cdk destroy"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.180.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.0.0"
  }
}
